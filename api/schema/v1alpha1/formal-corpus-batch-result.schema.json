{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/formal-corpus-batch-result.schema.json",
  "title": "Argus FormalCorpusBatchResult v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "evaluation_run_id", "cases", "completed_at", "completed_by"],
  "properties": {
    "schema_version": {"const": "argus.formal_corpus_batch_result.v1alpha1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "evaluation_run_id": {"$ref": "#/$defs/id"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "completed_at": {"type": "string", "format": "date-time"},
    "completed_by": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_run_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"const": "argus.review_run.v1alpha1"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_review_run_id", "formal_review_run_id", "formal_review_run_ref"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "source_review_run_id": {"$ref": "#/$defs/id"},
        "formal_review_run_id": {"$ref": "#/$defs/id"},
        "formal_review_run_ref": {"$ref": "#/$defs/review_run_ref"}
      }
    }
  }
}
