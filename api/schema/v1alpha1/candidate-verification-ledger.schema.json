{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/candidate-verification-ledger.schema.json",
  "title": "Argus CandidateVerificationLedger v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_ledger_id",
    "review_run_id",
    "execution_id",
    "hypothesis_set_id",
    "target_digest",
    "completeness",
    "summary",
    "facts",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "argus.candidate_verification_ledger.v1alpha1"},
    "verification_ledger_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "review_run_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "execution_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "hypothesis_set_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "target_digest": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"},
    "completeness": {"enum": ["complete", "partial"]},
    "summary": {"$ref": "#/$defs/summary"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "generated_at": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/utcTimestamp"}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "confirmed", "rejected", "inconclusive", "unverified"],
      "properties": {
        "candidates": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0},
        "unverified": {"type": "integer", "minimum": 0}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_fact_id", "candidate_id", "occurrence_id", "observation"],
      "properties": {
        "verification_fact_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "candidate_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "occurrence_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "observation": {"$ref": "review-hypothesis-set.schema.json#/$defs/verificationObservation"}
      }
    }
  }
}
