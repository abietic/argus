{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/normalization-quality-run.schema.json",
  "title": "Argus NormalizationQualityRun v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quality_run_id", "policy_revision", "authority", "cases", "summary", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.normalization_quality_run.v1alpha1"},
    "quality_run_id": {"$ref": "#/$defs/id"},
    "policy_revision": {"$ref": "#/$defs/id"},
    "authority": {"const": "independent_oracle_evaluation"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/case"}},
    "summary": {"$ref": "#/$defs/summary"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "oracle_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle_id", "case_id", "revision", "registered_event_id", "oracle_ref", "attestation_id", "trust_authority", "trust_key_id", "trust_key_revision", "trust_key_registered_event_id"],
      "properties": {
        "oracle_id": {"$ref": "#/$defs/id"},
        "case_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "registered_event_id": {"$ref": "#/$defs/id"},
        "oracle_ref": {"$ref": "#/$defs/artifact_ref"},
        "attestation_id": {"$ref": "#/$defs/id"},
        "trust_authority": {"$ref": "#/$defs/id"},
        "trust_key_id": {"$ref": "#/$defs/id"},
        "trust_key_revision": {"$ref": "#/$defs/id"},
        "trust_key_registered_event_id": {"$ref": "#/$defs/id"}
      }
    },
    "ratio": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "numerator", "denominator", "value_ppm"],
      "properties": {
        "available": {"type": "boolean"},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "value_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "reason_code": {"$ref": "#/$defs/id"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "oracle_id", "oracle_binding", "source_review_run_id", "source_review_run_ref", "raw_candidate_collection_ref", "split", "eligible_raw_candidates", "oracle_unique_claims", "predicted_unique_claims", "unique_claim_delta", "true_duplicate_pairs", "false_duplicate_pairs", "missed_duplicate_pairs", "true_distinct_pairs", "pairwise_precision", "pairwise_recall", "false_merge_rate", "exact_partition_match", "policy_exposed"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "oracle_id": {"$ref": "#/$defs/id"},
        "oracle_binding": {"$ref": "#/$defs/oracle_binding"},
        "source_review_run_id": {"$ref": "#/$defs/id"},
        "source_review_run_ref": {"$ref": "#/$defs/artifact_ref"},
        "raw_candidate_collection_ref": {"$ref": "#/$defs/artifact_ref"},
        "split": {"enum": ["train", "dev", "test", "holdout"]},
        "eligible_raw_candidates": {"type": "integer", "minimum": 1},
        "oracle_unique_claims": {"type": "integer", "minimum": 1},
        "predicted_unique_claims": {"type": "integer", "minimum": 1},
        "unique_claim_delta": {"type": "integer"},
        "true_duplicate_pairs": {"type": "integer", "minimum": 0},
        "false_duplicate_pairs": {"type": "integer", "minimum": 0},
        "missed_duplicate_pairs": {"type": "integer", "minimum": 0},
        "true_distinct_pairs": {"type": "integer", "minimum": 0},
        "pairwise_precision": {"$ref": "#/$defs/ratio"},
        "pairwise_recall": {"$ref": "#/$defs/ratio"},
        "false_merge_rate": {"$ref": "#/$defs/ratio"},
        "exact_partition_match": {"type": "boolean"},
        "policy_exposed": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["cases", "eligible_raw_candidates", "oracle_unique_claims", "predicted_unique_claims", "unique_claim_delta", "true_duplicate_pairs", "false_duplicate_pairs", "missed_duplicate_pairs", "true_distinct_pairs", "pairwise_precision", "pairwise_recall", "false_merge_rate", "exact_partition_matches", "policy_exposed_cases", "independent_evidence_cases"],
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "eligible_raw_candidates": {"type": "integer", "minimum": 1},
        "oracle_unique_claims": {"type": "integer", "minimum": 1},
        "predicted_unique_claims": {"type": "integer", "minimum": 1},
        "unique_claim_delta": {"type": "integer"},
        "true_duplicate_pairs": {"type": "integer", "minimum": 0},
        "false_duplicate_pairs": {"type": "integer", "minimum": 0},
        "missed_duplicate_pairs": {"type": "integer", "minimum": 0},
        "true_distinct_pairs": {"type": "integer", "minimum": 0},
        "pairwise_precision": {"$ref": "#/$defs/ratio"},
        "pairwise_recall": {"$ref": "#/$defs/ratio"},
        "false_merge_rate": {"$ref": "#/$defs/ratio"},
        "exact_partition_matches": {"type": "integer", "minimum": 0},
        "policy_exposed_cases": {"type": "integer", "minimum": 0},
        "independent_evidence_cases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
