{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/calibration-promotion-prepare-request.schema.json",
  "title": "Argus CalibrationPromotionPrepareRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "calibration_run_id", "expected_calibration_run_sha256", "baseline_review_run_id", "baseline_config_revision_id", "baseline_config_revision", "variant_config_revision_id", "variant_config_revision", "promotion_variant_id", "promotion_policy_revision", "owner", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.calibration_promotion_prepare_request.v1alpha1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "calibration_run_id": {"$ref": "#/$defs/id"},
    "expected_calibration_run_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_review_run_id": {"$ref": "#/$defs/id"},
    "baseline_config_revision_id": {"$ref": "#/$defs/id"},
    "baseline_config_revision": {"$ref": "#/$defs/id"},
    "variant_config_revision_id": {"$ref": "#/$defs/id"},
    "variant_config_revision": {"$ref": "#/$defs/id"},
    "promotion_variant_id": {"$ref": "#/$defs/id"},
    "promotion_policy_revision": {"$ref": "#/$defs/id"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]*$", "not": {"pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
