{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-run-request.schema.json",
  "title": "Argus EvaluationRunRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_run_id", "evaluator_revision", "bindings", "created_at"],
  "properties": {
    "schema_version": { "const": "argus.evaluation_run_request.v1alpha1" },
    "evaluation_run_id": { "$ref": "#/$defs/id" },
    "evaluator_revision": { "$ref": "#/$defs/id" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expected_label_revision", "review_run_id"],
        "properties": {
          "case_id": { "$ref": "#/$defs/id" },
          "expected_label_revision": { "type": "integer", "minimum": 1 },
          "review_run_id": { "$ref": "#/$defs/id" },
          "dimension_scope": {
            "type": "array",
            "maxItems": 16,
            "items": { "$ref": "#/$defs/versioned_ref" }
          },
          "apply_trial": { "$ref": "apply-trial.schema.json" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
