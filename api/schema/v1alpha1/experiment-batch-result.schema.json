{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/experiment-batch-result.schema.json",
  "title": "Argus ExperimentBatchResult v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "variant_evaluation_run_id", "experiment_run_id", "cases", "completed_at", "completed_by"],
  "properties": {
    "schema_version": { "const": "argus.experiment_batch_result.v1alpha1" },
    "batch_id": { "$ref": "#/$defs/id" },
    "variant_evaluation_run_id": { "$ref": "#/$defs/id" },
    "experiment_run_id": { "$ref": "#/$defs/id" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "completed_at": { "type": "string", "format": "date-time" },
    "completed_by": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": { "type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "baseline_review_run_id", "variant_review_run_id", "variant_review_run_ref", "replay_change_set_ref"],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "baseline_review_run_id": { "$ref": "#/$defs/id" },
        "variant_review_run_id": { "$ref": "#/$defs/id" },
        "variant_review_run_ref": { "$ref": "#/$defs/artifact_ref" },
        "replay_change_set_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    }
  }
}
