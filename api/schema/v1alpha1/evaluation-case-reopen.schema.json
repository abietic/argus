{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-case-reopen.schema.json",
  "title": "Argus EvaluationCaseReopen v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "expected_governance_revision", "reason", "evidence_refs", "affected_experiment_ids", "reopened_at"],
  "properties": {
    "schema_version": {"const": "argus.evaluation_case_reopen.v1alpha1"},
    "case_id": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "expected_governance_revision": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "evaluation-case.schema.json#/$defs/artifact_uri"}},
    "affected_experiment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "evaluation-case.schema.json#/$defs/id"}},
    "reopened_at": {"type": "string", "format": "date-time"}
  }
}
