{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/publication-grant-reservation.schema.json",
  "title": "Argus PublicationGrantReservation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "grant_sha256", "publication_id", "idempotency_key", "reserved_at"],
  "properties": {
    "schema_version": {"const": "argus.publication_grant_reservation.v1alpha1"},
    "grant_id": {"$ref": "#/$defs/id"},
    "grant_sha256": {"$ref": "#/$defs/sha256"},
    "publication_id": {"$ref": "#/$defs/id"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "reserved_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1F\\x7F]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
