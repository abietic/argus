{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/normalization-oracle.schema.json",
  "title": "Argus NormalizationOracle v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_id", "corpus_snapshot_ref", "case_id", "split", "label_revision", "source_review_run_id", "source_review_run_ref", "raw_candidate_collection_ref", "target_digest", "eligible_raw_candidate_ids", "equivalence_classes", "adjudication", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.normalization_oracle.v1alpha1"},
    "oracle_id": {"$ref": "#/$defs/id"},
    "corpus_snapshot_ref": {"$ref": "#/$defs/corpus_ref"},
    "case_id": {"$ref": "#/$defs/id"},
    "split": {"enum": ["train", "dev", "test", "holdout"]},
    "label_revision": {"type": "integer", "minimum": 1},
    "source_review_run_id": {"$ref": "#/$defs/id"},
    "source_review_run_ref": {"$ref": "#/$defs/review_run_ref"},
    "raw_candidate_collection_ref": {"$ref": "#/$defs/raw_ref"},
    "target_digest": {"$ref": "#/$defs/sha256"},
    "eligible_raw_candidate_ids": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "equivalence_classes": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/equivalence_class"}},
    "adjudication": {"$ref": "#/$defs/adjudication"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "corpus_ref": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"contract": {"const": "argus.corpus_snapshot.v1alpha1"}}}]},
    "review_run_ref": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"contract": {"const": "argus.review_run.v1alpha1"}}}]},
    "raw_ref": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"contract": {"const": "argus.agent_review_raw_candidate_collection.v1alpha1"}}}]},
    "equivalence_class": {
      "type": "object", "additionalProperties": false,
      "required": ["class_id", "raw_candidate_ids"],
      "properties": {
        "class_id": {"$ref": "#/$defs/id"},
        "raw_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "adjudication": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "revision", "reviewer_ids", "adjudicator_id", "evidence_refs", "observed_policy_revisions", "adjudicated_at"],
      "properties": {
        "authority": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/id"},
        "reviewer_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "adjudicator_id": {"$ref": "#/$defs/id"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}},
        "observed_policy_revisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "adjudicated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
