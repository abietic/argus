{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/review-preparation.schema.json",
  "title": "Argus deterministic review preparation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "request_sha256", "config_bundle_sha256", "build_identity", "repository_root", "target_ref", "input_ref", "context_provider_receipt_refs"],
  "properties": {
    "schema_version": {"const": "argus.review_preparation.v1alpha1"},
    "run_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "config_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "build_identity": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "pattern": "^/"},
    "target_ref": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"contract": {"const": "argus.materialized_target.v1alpha1"}}}]},
    "input_ref": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"contract": {"const": "argus.review_input.v1alpha1"}}}]},
    "context_provider_receipt_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"contract": {"const": "argus.context_provider_execution_receipt.v1alpha1"}}}]}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"type": "string", "minLength": 1}
      }
    }
  }
}
