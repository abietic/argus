{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-case-annotation.schema.json",
  "title": "Argus EvaluationCaseAnnotation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "expected_governance_revision", "expected_label_revision", "verdict", "rationale", "evidence_refs", "reviewed_at"],
  "properties": {
    "schema_version": { "const": "argus.evaluation_case_annotation.v1alpha1" },
    "case_id": { "$ref": "evaluation-case.schema.json#/$defs/id" },
    "expected_governance_revision": { "type": "integer", "minimum": 1 },
    "expected_label_revision": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["approve", "reject"] },
    "proposed_label": { "$ref": "evaluation-case.schema.json#/$defs/label" },
    "label_policy_revision": { "$ref": "evaluation-case.schema.json#/$defs/id" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "evaluation-case.schema.json#/$defs/artifact_uri" } },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    { "properties": { "verdict": { "const": "approve" } }, "required": ["proposed_label", "label_policy_revision"] },
    { "properties": { "verdict": { "const": "reject" } }, "not": { "anyOf": [{ "required": ["proposed_label"] }, { "required": ["label_policy_revision"] }] } }
  ]
}
