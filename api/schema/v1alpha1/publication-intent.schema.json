{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/publication-intent.schema.json",
  "title": "Argus PublicationIntent v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.publication_intent.v1alpha1"},
    "grant_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1F\\x7F]+$"}
  }
}
