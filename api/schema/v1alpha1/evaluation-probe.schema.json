{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-probe.schema.json",
  "title": "Argus EvaluationProbe v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "kind", "review_run_id", "oracle", "receipt_ref", "source_authority", "source_id", "source_revision", "recorded_at"],
  "properties": {
    "schema_version": {"const": "argus.evaluation_probe.v1alpha1"},
    "probe_id": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "kind": {"enum": ["mutation_defect", "synthetic_defect", "synthetic_clean", "workflow_invariant"]},
    "review_run_id": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "oracle": {"$ref": "#/$defs/oracle"},
    "receipt_ref": {"$ref": "#/$defs/artifact_ref"},
    "source_authority": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "source_id": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "source_revision": {"$ref": "evaluation-case.schema.json#/$defs/id"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "prior_probe_id": {"$ref": "evaluation-case.schema.json#/$defs/id"}
  },
  "$defs": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "revision", "expected_outcome", "anchors", "evidence_artifacts"],
      "properties": {
        "authority": {"$ref": "evaluation-case.schema.json#/$defs/id"},
        "revision": {"$ref": "evaluation-case.schema.json#/$defs/id"},
        "expected_outcome": {"enum": ["defect_present", "clean", "invariant_pass", "invariant_fail"]},
        "category": {"$ref": "evaluation-case.schema.json#/$defs/id"},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "anchors": {"type": "array", "uniqueItems": true, "items": {"$ref": "evaluation-case.schema.json#/$defs/anchor"}},
        "invariant_id": {"$ref": "evaluation-case.schema.json#/$defs/id"},
        "evidence_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"$ref": "evaluation-case.schema.json#/$defs/artifact_uri"},
        "sha256": {"$ref": "evaluation-case.schema.json#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"$ref": "evaluation-case.schema.json#/$defs/id"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["mutation_defect", "synthetic_defect"]}}},
      "then": {
        "properties": {"oracle": {"required": ["category", "severity"], "properties": {"expected_outcome": {"const": "defect_present"}, "anchors": {"minItems": 1}}, "not": {"required": ["invariant_id"]}}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "synthetic_clean"}}},
      "then": {
        "properties": {"oracle": {"properties": {"expected_outcome": {"const": "clean"}, "anchors": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["category"]}, {"required": ["severity"]}, {"required": ["invariant_id"]}]}}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "workflow_invariant"}}},
      "then": {
        "properties": {"oracle": {"required": ["invariant_id"], "properties": {"expected_outcome": {"enum": ["invariant_pass", "invariant_fail"]}, "anchors": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["category"]}, {"required": ["severity"]}]}}}
      }
    }
  ]
}
