{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/finding-calibration-ledger.schema.json",
  "title": "Argus FindingCalibrationLedger v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calibration_ledger_id", "review_run_id", "execution_id", "report_id", "verification_ledger_id", "target_digest", "summary", "facts", "generated_at"],
  "properties": {
    "schema_version": {"const": "argus.finding_calibration_ledger.v1alpha1"},
    "calibration_ledger_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "review_run_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "execution_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "report_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "verification_ledger_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "target_digest": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"},
    "profile": {"$ref": "#/$defs/profile"},
    "summary": {"$ref": "#/$defs/summary"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "generated_at": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/utcTimestamp"}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_ppm", "confidence_ppm"],
      "properties": {
        "raw_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "revision", "points", "sha256"],
      "properties": {
        "schema_version": {"const": "argus.calibration_profile.v1alpha1"},
        "id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "revision": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}},
        "sha256": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "calibrated", "unavailable"],
      "properties": {
        "findings": {"type": "integer", "minimum": 0},
        "calibrated": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_fact_id", "finding_id", "candidate_id", "verification_fact_id", "status", "reason_code", "raw_score_available", "raw_score_ppm", "confidence_available", "confidence_ppm"],
      "properties": {
        "calibration_fact_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "finding_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "candidate_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "verification_fact_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "status": {"enum": ["calibrated", "unavailable"]},
        "reason_code": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "profile": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
        "raw_score_available": {"type": "boolean"},
        "raw_score_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "confidence_available": {"type": "boolean"},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
