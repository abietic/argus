{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/formal-corpus-batch-request.schema.json",
  "title": "Argus FormalCorpusBatchRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "evaluation_run_id", "evaluator_revision", "executor_revision", "corpus_snapshot_ref", "max_concurrency", "cases", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.formal_corpus_batch_request.v1alpha1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "evaluation_run_id": {"$ref": "#/$defs/id"},
    "evaluator_revision": {"$ref": "#/$defs/id"},
    "executor_revision": {"$ref": "#/$defs/id"},
    "corpus_snapshot_ref": {"$ref": "#/$defs/corpus_snapshot_ref"},
    "executor_template_ref": {"$ref": "#/$defs/executor_template_ref"},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
    "cases": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/case"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executor_template_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"const": "argus.formal_corpus_executor_template.v1alpha1"}
      }
    },
    "corpus_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"const": "argus.corpus_snapshot.v1alpha1"}
      }
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "status", "revision"],
      "properties": {
        "component": {"enum": ["prompt", "rule", "model", "index"]},
        "status": {"enum": ["seen", "not_seen"]},
        "revision": {"$ref": "#/$defs/id"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_label_revision", "source_review_run_id", "exposure_observations"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "expected_label_revision": {"type": "integer", "minimum": 1},
        "source_review_run_id": {"$ref": "#/$defs/id"},
        "exposure_observations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"component": {"const": "prompt"}}}]},
            {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"component": {"const": "rule"}}}]},
            {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"component": {"const": "model"}}}]},
            {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"component": {"const": "index"}}}]}
          ],
          "items": false
        },
        "dimension_scope": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/versioned_ref"}}
      }
    }
  }
}
