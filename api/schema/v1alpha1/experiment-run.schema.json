{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/experiment-run.schema.json",
  "title": "Argus ExperimentRun v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_run_id", "experiment_revision", "baseline_evaluation_run_id", "variant_evaluation_run_id", "evaluator_revision", "variable", "comparisons", "summary", "quality", "cost", "usage", "latency", "instability", "created_at", "recorded_at", "recorded_by"],
  "properties": {
    "schema_version": { "const": "argus.experiment_run.v1alpha1" },
    "experiment_run_id": { "$ref": "#/$defs/id" },
    "experiment_revision": { "$ref": "#/$defs/id" },
    "baseline_evaluation_run_id": { "$ref": "#/$defs/id" },
    "variant_evaluation_run_id": { "$ref": "#/$defs/id" },
    "evaluator_revision": { "$ref": "#/$defs/id" },
    "variable": { "enum": ["rule_pack", "skill_pack", "knowledge_pack", "prompt", "model", "index", "workflow", "filter_policy", "finding_governance", "budget"] },
    "comparisons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comparison" } },
    "summary": { "$ref": "#/$defs/summary" },
    "quality": { "$ref": "#/$defs/availability" },
    "cost": { "$ref": "#/$defs/availability" },
    "usage": { "$ref": "#/$defs/availability" },
    "latency": { "$ref": "#/$defs/availability" },
    "instability": { "$ref": "#/$defs/availability" },
    "created_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "availability": {
      "type": "object", "additionalProperties": false, "required": ["available"],
      "properties": { "available": { "type": "boolean" }, "reason_code": { "$ref": "#/$defs/id" } }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_type", "label_revision", "baseline_review_run_id", "variant_review_run_id", "baseline_review_run_ref", "variant_review_run_ref", "replay_change_set_ref", "baseline_config_sha256", "variant_config_sha256", "baseline_duration_ms", "variant_duration_ms", "latency_delta_ms", "latency_authority", "expected_anchor_count", "baseline_matched_anchor_count", "variant_matched_anchor_count", "matched_anchor_delta", "baseline_localization", "variant_localization", "localization", "expected_suppression_count", "baseline_observed_suppressions", "variant_observed_suppressions", "baseline_suppressed_targets", "variant_suppressed_targets", "suppressed_target_delta", "baseline_escaped_targets", "variant_escaped_targets", "escaped_target_delta", "baseline_inconclusive_targets", "variant_inconclusive_targets", "baseline_filter_efficacy", "variant_filter_efficacy", "filter_efficacy", "baseline_apply_checks_passed", "variant_apply_checks_passed", "apply_checks_passed_delta", "baseline_apply_checks_failed", "variant_apply_checks_failed", "apply_checks_failed_delta", "baseline_apply_authority", "variant_apply_authority", "baseline_apply_fidelity", "variant_apply_fidelity", "apply_fidelity", "baseline_usage_authority", "variant_usage_authority", "baseline_usage", "variant_usage", "usage", "baseline_input_tokens", "variant_input_tokens", "input_token_delta", "baseline_output_tokens", "variant_output_tokens", "output_token_delta", "baseline_total_tokens", "variant_total_tokens", "total_token_delta", "baseline_verdict", "variant_verdict", "transition", "reason_code", "dimensions"],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "case_type": { "enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "fix_validation", "mutation_diagnostic", "workflow_invariant"] },
        "label_revision": { "type": "integer", "minimum": 1 },
        "baseline_review_run_id": { "$ref": "#/$defs/id" },
        "variant_review_run_id": { "$ref": "#/$defs/id" },
        "baseline_review_run_ref": { "$ref": "#/$defs/artifact_ref" },
        "variant_review_run_ref": { "$ref": "#/$defs/artifact_ref" },
        "replay_change_set_ref": { "$ref": "#/$defs/artifact_ref" },
        "baseline_config_sha256": { "$ref": "#/$defs/sha256" },
        "variant_config_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_duration_ms": { "type": "integer", "minimum": 0 },
        "variant_duration_ms": { "type": "integer", "minimum": 0 },
        "latency_delta_ms": { "type": "integer" },
        "latency_authority": { "enum": ["review_run_stage_attempts", "unavailable_postprocessing_only"] },
        "expected_anchor_count": { "type": "integer", "minimum": 0 },
        "baseline_matched_anchor_count": { "type": "integer", "minimum": 0 },
        "variant_matched_anchor_count": { "type": "integer", "minimum": 0 },
        "matched_anchor_delta": { "type": "integer" },
        "baseline_localization": { "$ref": "#/$defs/availability" },
        "variant_localization": { "$ref": "#/$defs/availability" },
        "localization": { "$ref": "#/$defs/availability" },
        "expected_suppression_count": { "type": "integer", "minimum": 0 },
        "baseline_observed_suppressions": { "type": "integer", "minimum": 0 },
        "variant_observed_suppressions": { "type": "integer", "minimum": 0 },
        "baseline_suppressed_targets": { "type": "integer", "minimum": 0 },
        "variant_suppressed_targets": { "type": "integer", "minimum": 0 },
        "suppressed_target_delta": { "type": "integer" },
        "baseline_escaped_targets": { "type": "integer", "minimum": 0 },
        "variant_escaped_targets": { "type": "integer", "minimum": 0 },
        "escaped_target_delta": { "type": "integer" },
        "baseline_inconclusive_targets": { "type": "integer", "minimum": 0 },
        "variant_inconclusive_targets": { "type": "integer", "minimum": 0 },
        "baseline_filter_efficacy": { "$ref": "#/$defs/availability" },
        "variant_filter_efficacy": { "$ref": "#/$defs/availability" },
        "filter_efficacy": { "$ref": "#/$defs/availability" },
        "baseline_apply_checks_passed": { "type": "integer", "minimum": 0 },
        "variant_apply_checks_passed": { "type": "integer", "minimum": 0 },
        "apply_checks_passed_delta": { "type": "integer" },
        "baseline_apply_checks_failed": { "type": "integer", "minimum": 0 },
        "variant_apply_checks_failed": { "type": "integer", "minimum": 0 },
        "apply_checks_failed_delta": { "type": "integer" },
        "baseline_apply_authority": { "enum": ["unavailable", "local_host_unattested"] },
        "variant_apply_authority": { "enum": ["unavailable", "local_host_unattested"] },
        "baseline_apply_fidelity": { "$ref": "#/$defs/availability" },
        "variant_apply_fidelity": { "$ref": "#/$defs/availability" },
        "apply_fidelity": { "$ref": "#/$defs/availability" },
        "baseline_usage_authority": { "enum": ["unavailable", "worker_self_report_diagnostic"] },
        "variant_usage_authority": { "enum": ["unavailable", "worker_self_report_diagnostic"] },
        "baseline_usage": { "$ref": "#/$defs/availability" },
        "variant_usage": { "$ref": "#/$defs/availability" },
        "usage": { "$ref": "#/$defs/availability" },
        "baseline_input_tokens": { "type": "integer", "minimum": 0 },
        "variant_input_tokens": { "type": "integer", "minimum": 0 },
        "input_token_delta": { "type": "integer" },
        "baseline_output_tokens": { "type": "integer", "minimum": 0 },
        "variant_output_tokens": { "type": "integer", "minimum": 0 },
        "output_token_delta": { "type": "integer" },
        "baseline_total_tokens": { "type": "integer", "minimum": 0 },
        "variant_total_tokens": { "type": "integer", "minimum": 0 },
        "total_token_delta": { "type": "integer" },
        "baseline_verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "variant_verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "transition": { "enum": ["improved", "regressed", "unchanged", "inconclusive"] },
        "reason_code": { "$ref": "#/$defs/id" },
        "dimensions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/dimension_comparison" }
        }
      }
    },
    "versioned_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dimension_comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "baseline_dimension", "variant_dimension", "baseline_candidate_count", "variant_candidate_count", "candidate_delta", "baseline_raw_candidate_count", "variant_raw_candidate_count", "raw_candidate_delta", "baseline_normalization_retained_count", "variant_normalization_retained_count", "normalization_retained_delta", "baseline_merged_duplicate_count", "variant_merged_duplicate_count", "merged_duplicate_delta", "baseline_rejected_invalid_count", "variant_rejected_invalid_count", "rejected_invalid_delta", "baseline_excluded_budget_count", "variant_excluded_budget_count", "excluded_budget_delta", "baseline_context_gap_count", "variant_context_gap_count", "context_gap_delta", "baseline_finding_count", "variant_finding_count", "finding_delta", "baseline_evaluated_finding_count", "variant_evaluated_finding_count", "evaluated_finding_delta", "baseline_cumulative_duration_ms", "variant_cumulative_duration_ms", "cumulative_duration_delta_ms", "baseline_total_tokens", "variant_total_tokens", "total_token_delta", "baseline_execution_coverage", "variant_execution_coverage", "baseline_normalization", "variant_normalization", "normalization", "baseline_context_coverage", "variant_context_coverage", "context_coverage", "baseline_usage", "variant_usage", "usage", "baseline_verdict", "variant_verdict", "transition", "reason_code"],
      "properties": {
        "dimension_id": { "$ref": "#/$defs/id" },
        "baseline_dimension": { "$ref": "#/$defs/versioned_ref" },
        "variant_dimension": { "$ref": "#/$defs/versioned_ref" },
        "baseline_candidate_count": { "type": "integer", "minimum": 0 },
        "variant_candidate_count": { "type": "integer", "minimum": 0 },
        "candidate_delta": { "type": "integer" },
        "baseline_raw_candidate_count": { "type": "integer", "minimum": 0 },
        "variant_raw_candidate_count": { "type": "integer", "minimum": 0 },
        "raw_candidate_delta": { "type": "integer" },
        "baseline_normalization_retained_count": { "type": "integer", "minimum": 0 },
        "variant_normalization_retained_count": { "type": "integer", "minimum": 0 },
        "normalization_retained_delta": { "type": "integer" },
        "baseline_merged_duplicate_count": { "type": "integer", "minimum": 0 },
        "variant_merged_duplicate_count": { "type": "integer", "minimum": 0 },
        "merged_duplicate_delta": { "type": "integer" },
        "baseline_rejected_invalid_count": { "type": "integer", "minimum": 0 },
        "variant_rejected_invalid_count": { "type": "integer", "minimum": 0 },
        "rejected_invalid_delta": { "type": "integer" },
        "baseline_excluded_budget_count": { "type": "integer", "minimum": 0 },
        "variant_excluded_budget_count": { "type": "integer", "minimum": 0 },
        "excluded_budget_delta": { "type": "integer" },
        "baseline_context_gap_count": { "type": "integer", "minimum": 0 },
        "variant_context_gap_count": { "type": "integer", "minimum": 0 },
        "context_gap_delta": { "type": "integer" },
        "baseline_finding_count": { "type": "integer", "minimum": 0 },
        "variant_finding_count": { "type": "integer", "minimum": 0 },
        "finding_delta": { "type": "integer" },
        "baseline_evaluated_finding_count": { "type": "integer", "minimum": 0 },
        "variant_evaluated_finding_count": { "type": "integer", "minimum": 0 },
        "evaluated_finding_delta": { "type": "integer" },
        "baseline_cumulative_duration_ms": { "type": "integer", "minimum": 0 },
        "variant_cumulative_duration_ms": { "type": "integer", "minimum": 0 },
        "cumulative_duration_delta_ms": { "type": "integer" },
        "baseline_total_tokens": { "type": "integer", "minimum": 0 },
        "variant_total_tokens": { "type": "integer", "minimum": 0 },
        "total_token_delta": { "type": "integer" },
        "baseline_execution_coverage": { "$ref": "#/$defs/availability" },
        "variant_execution_coverage": { "$ref": "#/$defs/availability" },
        "baseline_normalization": { "$ref": "#/$defs/availability" },
        "variant_normalization": { "$ref": "#/$defs/availability" },
        "normalization": { "$ref": "#/$defs/availability" },
        "baseline_context_coverage": { "$ref": "#/$defs/availability" },
        "variant_context_coverage": { "$ref": "#/$defs/availability" },
        "context_coverage": { "$ref": "#/$defs/availability" },
        "baseline_usage": { "$ref": "#/$defs/availability" },
        "variant_usage": { "$ref": "#/$defs/availability" },
        "usage": { "$ref": "#/$defs/availability" },
        "baseline_verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "variant_verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "transition": { "enum": ["improved", "regressed", "unchanged", "inconclusive"] },
        "reason_code": { "$ref": "#/$defs/id" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": { "type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["cases", "improved", "regressed", "unchanged", "inconclusive", "pass_delta", "fail_delta"],
      "properties": {
        "cases": { "type": "integer", "minimum": 1 },
        "improved": { "type": "integer", "minimum": 0 },
        "regressed": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "pass_delta": { "type": "integer" },
        "fail_delta": { "type": "integer" }
      }
    }
  }
}
