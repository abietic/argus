{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/corpus-snapshot-request.schema.json",
  "title": "Argus CorpusSnapshotRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "revision", "purpose", "split", "cases", "created_at"],
  "properties": {
    "schema_version": {"const": "argus.corpus_snapshot_request.v1alpha1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/id"},
    "purpose": {"enum": ["development", "quality_gate", "promotion_gate"]},
    "split": {"enum": ["train", "dev", "test", "holdout"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/case"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_governance_revision", "expected_label_revision", "source_review_run_id"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "expected_governance_revision": {"type": "integer", "minimum": 1},
        "expected_label_revision": {"type": "integer", "minimum": 1},
        "source_review_run_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
