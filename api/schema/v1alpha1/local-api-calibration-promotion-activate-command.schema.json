{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/local-api-calibration-promotion-activate-command.schema.json",
  "title": "Argus LocalAPICalibrationPromotionActivateCommand v1alpha1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "rollout", "mutation"],
  "properties": {
    "schema_version": {"const": "argus.local_api_calibration_promotion_activate_command.v1alpha1"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]*$"},
    "rollout": {"type": "object", "additionalProperties": false, "required": ["percentage"], "properties": {"percentage": {"type": "integer", "minimum": 1, "maximum": 100}, "seed": {"type": "string", "maxLength": 256}}},
    "mutation": {"$ref": "local-api-mutation.schema.json"}
  }
}
