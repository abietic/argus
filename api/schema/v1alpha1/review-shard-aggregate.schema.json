{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/review-shard-aggregate.schema.json",
  "title": "Argus ReviewShardAggregate v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "manifest_ref", "completeness", "outputs", "coverage", "gaps", "completed_at", "completed_by"],
  "properties": {
    "schema_version": {"const": "argus.review_shard_aggregate.v1alpha1"},
    "run_id": {"$ref": "#/$defs/id"},
    "manifest_ref": {"$ref": "#/$defs/manifestRef"},
    "completeness": {"enum": ["complete", "partial"]},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "coverage": {"$ref": "review-shard-manifest.schema.json#/$defs/coverage"},
    "gaps": {"type": "array", "items": {"$ref": "review-shard-manifest.schema.json#/$defs/gap"}},
    "completed_at": {"type": "string", "format": "date-time"},
    "completed_by": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {"uri": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}, "contract": {"type": "string", "minLength": 1}}
    },
    "manifestRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"contract": {"const": "argus.review_shard_manifest.v1alpha1"}}}]},
    "stageResultRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"contract": {"const": "argus.reviewcore_artifact.v1alpha1"}}}]},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["shard_id", "ordinal", "output_ref", "generation", "fencing_token"],
      "properties": {"shard_id": {"$ref": "#/$defs/id"}, "ordinal": {"type": "integer", "minimum": 0}, "output_ref": {"$ref": "#/$defs/stageResultRef"}, "generation": {"type": "integer", "minimum": 1}, "fencing_token": {"type": "integer", "minimum": 1}}
    }
  }
}
