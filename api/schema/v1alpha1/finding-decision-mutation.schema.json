{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/finding-decision-mutation.schema.json",
  "title": "Argus FindingDecisionMutation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "actor", "roles", "audit", "at"],
  "properties": {
    "schema_version": {"const": "argus.finding_decision_mutation.v1alpha1"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "service"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["finding_reviewer", "publication_approver"]}
    },
    "audit": {"type": "string", "minLength": 1, "maxLength": 4096},
    "at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\\\x00-\\x1F\\x7F]+$"}
  }
}
