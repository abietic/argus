{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-case.schema.json",
  "title": "Argus EvaluationCase v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "type", "provenance", "license_consent", "classification", "owner", "input_snapshot_ref", "label", "label_policy_revision", "review_state", "dataset_state", "split", "clone_group_id", "eligibility", "created_at"],
  "properties": {
    "schema_version": { "const": "argus.evaluation_case.v1alpha1" },
    "case_id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "fix_validation", "mutation_diagnostic", "workflow_invariant"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "license_consent": { "$ref": "#/$defs/license" },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 256 },
    "input_snapshot_ref": { "$ref": "#/$defs/artifact_uri" },
    "label": { "$ref": "#/$defs/label" },
    "label_policy_revision": { "$ref": "#/$defs/id" },
    "review_state": { "enum": ["pending", "in_review", "approved", "rejected"] },
    "dataset_state": { "enum": ["candidate_pool", "gold", "active", "retired"] },
    "split": { "enum": ["unassigned", "train", "dev", "test", "holdout"] },
    "clone_group_id": { "$ref": "#/$defs/id" },
    "eligibility": { "$ref": "#/$defs/eligibility" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_uri": { "type": "string", "pattern": "^artifact://[^/]+/.+" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository_id", "source_id", "observed_at", "collected_at", "evidence_refs"],
      "properties": {
        "kind": { "enum": ["human_confirmed_finding", "rejected_false_positive", "incident_missed_defect", "reviewed_bug_fix_pair", "mutation", "synthetic", "production_feedback"] },
        "repository_id": { "$ref": "#/$defs/id" }, "source_id": { "$ref": "#/$defs/id" },
        "source_run_id": { "$ref": "#/$defs/id" }, "finding_id": { "$ref": "#/$defs/id" },
        "observed_at": { "type": "string", "format": "date-time" }, "collected_at": { "type": "string", "format": "date-time" },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_uri" } }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["license_id", "consent", "allowed_uses", "restrictions"],
      "properties": {
        "license_id": { "$ref": "#/$defs/id" },
        "consent": { "enum": ["explicit", "contractual", "authorized_internal", "public_license", "synthetic"] },
        "allowed_uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["candidate_pool", "evaluation", "training", "promotion"] } },
        "restrictions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "side", "start_line", "end_line", "source_digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\].*" },
        "side": { "enum": ["old", "new", "file"] },
        "start_line": { "type": "integer", "minimum": 1 }, "end_line": { "type": "integer", "minimum": 1 },
        "source_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "suppression_target": {
      "type": "object", "additionalProperties": false,
      "required": ["cluster_fingerprint"],
      "properties": { "cluster_fingerprint": { "$ref": "#/$defs/sha256" } }
    },
    "label": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_outcome", "anchors", "anchor_refs", "suppression_targets"],
      "properties": {
        "expected_outcome": { "enum": ["defect_present", "clean", "false_positive", "missed_defect", "fix_valid", "fix_invalid", "invariant_pass", "invariant_fail"] },
        "category": { "$ref": "#/$defs/id" }, "severity": { "enum": ["low", "medium", "high", "critical"] },
        "anchors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/anchor" } },
        "anchor_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_uri" } },
        "suppression_targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/suppression_target" } }
      }
    },
    "eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation", "training", "promotion", "production_distribution"],
      "properties": { "evaluation": { "type": "boolean" }, "training": { "type": "boolean" }, "promotion": { "type": "boolean" }, "production_distribution": { "type": "boolean" } }
    }
  }
}
