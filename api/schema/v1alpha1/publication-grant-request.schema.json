{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/publication-grant-request.schema.json",
  "title": "Argus PublicationGrantRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "publication_id", "publication_idempotency_key", "run_id", "finding_id", "provider", "repository_id", "change_kind", "change_id", "channel", "expected_permission_revision", "occurred_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "argus.publication_grant_request.v1alpha1"},
    "grant_id": {"$ref": "#/$defs/id"},
    "publication_id": {"$ref": "#/$defs/id"},
    "publication_idempotency_key": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "finding_id": {"$ref": "#/$defs/id"},
    "provider": {"$ref": "#/$defs/id"},
    "repository_id": {"$ref": "#/$defs/id"},
    "change_kind": {"const": "pull_request"},
    "change_id": {"$ref": "#/$defs/id"},
    "channel": {"enum": ["pull_request_inline", "pull_request_summary"]},
    "expected_permission_revision": {"$ref": "#/$defs/id"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1F\\x7F]+$"}
  }
}
