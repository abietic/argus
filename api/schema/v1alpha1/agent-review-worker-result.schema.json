{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/agent-review-worker-result.schema.json",
  "title": "Argus AgentReviewWorkerResult v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "attempt",
    "generation",
    "fencing_token",
    "idempotency_key",
    "capability_sha256",
    "status",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "argus.agent_review_worker_result.v1alpha1"},
    "work_item_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "idempotency_key": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "capability_sha256": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"},
    "status": {"enum": ["succeeded", "failed", "canceled"]},
    "report_sha256": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"},
    "report": {
      "allOf": [
        {"type": "object"},
        {"$ref": "#/$defs/nonNullJSONValue"}
      ]
    },
    "failure": {"$ref": "#/$defs/failure"},
    "completed_at": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/utcTimestamp"}
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "succeeded"}}
      },
      "then": {
        "required": ["report_sha256", "report"],
        "not": {"required": ["failure"]}
      },
      "else": {
        "required": ["failure"],
        "not": {
          "anyOf": [
            {"required": ["report_sha256"]},
            {"required": ["report"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "nonNullJSONValue": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/nonNullJSONValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/nonNullJSONValue"}
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
