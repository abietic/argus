{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/agent-review-plan.schema.json",
  "title": "Argus AgentReviewPlan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_run_id",
    "execution_id",
    "review_run_id",
    "execution_snapshot_ref",
    "review_input_ref",
    "target_digest",
    "rule_pack",
    "implementation",
    "normalization",
    "grouping",
    "context_dimensions",
    "review_dimensions",
    "verifier",
    "knowledge",
    "runtime",
    "profile",
    "agent",
    "provider",
    "model",
    "api_protocol",
    "tool_policy",
    "budget",
    "verification_required",
    "execution_class",
    "attestation",
    "side_effects",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "argus.agent_review_plan.v1alpha1"},
    "plan_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "source_run_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "execution_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "review_run_id": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/identifier"},
    "execution_snapshot_ref": {
      "allOf": [
        {"$ref": "agent-review-shadow-defs.schema.json#/$defs/artifactBinding"},
        {"properties": {
          "contract": {"const": "argus.execution_snapshot.v1alpha1"},
          "ref": {"properties": {"size_bytes": {"maximum": 67108864}}}
        }}
      ]
    },
    "review_input_ref": {
      "allOf": [
        {"$ref": "agent-review-shadow-defs.schema.json#/$defs/artifactBinding"},
        {"properties": {
          "contract": {"const": "argus.review_input.v1alpha1"},
          "ref": {"properties": {"size_bytes": {"maximum": 67108864}}}
        }}
      ]
    },
    "target_digest": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/sha256"},
    "rule_pack": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "implementation": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "normalization": {
      "allOf": [
        {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
        {"properties": {
          "id": {"const": "candidate-normalization"},
          "revision": {"enum": ["v0", "v1", "v2"]}
        }}
      ]
    },
    "grouping": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "context_dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"}
    },
    "review_dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"}
    },
    "verifier": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "knowledge": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"}
    },
    "runtime": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "profile": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "agent": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "provider": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "model": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/versionedRef"},
    "api_protocol": {"const": "anthropic_messages"},
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tools", "tool_network", "workspace_writes", "remote_writes"],
      "properties": {
        "allowed_tools": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "list_files"},
            {"const": "read_file"},
            {"const": "search_code"}
          ],
          "items": false
        },
        "tool_network": {"const": "deny"},
        "workspace_writes": {"const": "deny"},
        "remote_writes": {"const": "deny"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files",
        "max_groups",
        "max_candidates",
        "max_model_calls",
        "max_tool_calls",
        "max_output_tokens",
        "max_group_bytes",
        "max_target_bytes",
        "timeout_ms",
        "max_concurrency"
      ],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_groups": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_group_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_target_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "verification_required": {"const": true},
    "execution_class": {"const": "local_direct_provider_shadow"},
    "attestation": {"const": "non_attested"},
    "side_effects": {"const": "deny"},
    "created_at": {"$ref": "agent-review-shadow-defs.schema.json#/$defs/utcTimestamp"}
  }
}
