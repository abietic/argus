{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/corpus-snapshot.schema.json",
  "title": "Argus CorpusSnapshot v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "revision", "purpose", "split", "cases", "created_at", "created_by"],
  "properties": {
    "schema_version": {"const": "argus.corpus_snapshot.v1alpha1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/id"},
    "purpose": {"enum": ["development", "quality_gate", "promotion_gate"]},
    "split": {"enum": ["train", "dev", "test", "holdout"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/case"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_type", "split", "clone_group_id", "governance_revision", "label_revision", "current_case_sha256", "source_review_run_id", "source_review_run_ref", "target_snapshot_ref", "execution_snapshot_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "case_type": {"enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "mutation_diagnostic", "workflow_invariant"]},
        "split": {"enum": ["train", "dev", "test", "holdout"]},
        "clone_group_id": {"$ref": "#/$defs/id"},
        "governance_revision": {"type": "integer", "minimum": 1},
        "label_revision": {"type": "integer", "minimum": 1},
        "current_case_sha256": {"$ref": "#/$defs/sha256"},
        "source_review_run_id": {"$ref": "#/$defs/id"},
        "source_review_run_ref": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"contract": {"const": "argus.review_run.v1alpha1"}}}
          ]
        },
        "target_snapshot_ref": {
          "allOf": [
            {"$ref": "#/$defs/artifact_ref"},
            {"properties": {"contract": {"const": "argus.materialized_target.v1alpha1"}}}
          ]
        },
        "execution_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
