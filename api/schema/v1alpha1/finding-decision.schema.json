{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/finding-decision.schema.json",
  "title": "Argus FindingDecision v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "run_id", "finding_id", "sequence", "prior_decision_id", "initial_decision_id", "source_contract", "source_sha256", "action", "reason_code", "evidence_refs", "occurred_at", "recorded_at", "recorded_by", "roles", "audit", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "argus.finding_decision.v1alpha1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "finding_id": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 2, "maximum": 4294967295},
    "prior_decision_id": {"$ref": "#/$defs/id"},
    "initial_decision_id": {"$ref": "#/$defs/id"},
    "source_contract": {"enum": ["argus.finding_set.v1alpha1", "argus.governed_review_report.v1alpha1+json"]},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "action": {"enum": ["publish", "reject", "human_review"]},
    "reason_code": {"$ref": "#/$defs/id"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "recorded_by": {"$ref": "#/$defs/actor"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["finding_reviewer", "publication_approver"]}
    },
    "audit": {"type": "string", "minLength": 1, "maxLength": 4096},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\\\x00-\\x1F\\x7F]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "service"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id"],
      "properties": {
        "authority": {"$ref": "#/$defs/id"},
        "id": {"type": "string", "minLength": 1, "maxLength": 2048},
        "revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
