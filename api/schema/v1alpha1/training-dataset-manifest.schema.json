{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/training-dataset-manifest.schema.json",
  "title": "Argus TrainingDatasetManifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "dataset_id", "dataset_revision", "repository_id", "config_context", "config_bundle_ref", "data_policy", "content_mode", "contains_source_bytes", "self_labels_allowed", "samples", "created_by", "created_at", "sha256"],
  "properties": {
    "schema_version": {"const": "argus.training_dataset_manifest.v1alpha1"},
    "manifest_id": {"type": "string", "pattern": "^training-manifest-[0-9a-f]{24}$"},
    "dataset_id": {"$ref": "#/$defs/id"}, "dataset_revision": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"},
    "config_context": {"$ref": "#/$defs/config_context"},
    "config_bundle_ref": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"contract": {"const": "argus.config_bundle.v1alpha1"}}}]},
    "data_policy": {"$ref": "#/$defs/data_policy"},
    "content_mode": {"const": "reference_only_strict_redaction_required"},
    "contains_source_bytes": {"const": false}, "self_labels_allowed": {"const": false},
    "samples": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/sample"}},
    "created_by": {"$ref": "#/$defs/id"}, "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256", "size_bytes", "contract"], "properties": {"uri": {"$ref": "#/$defs/artifact_uri"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "contract": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "config_context": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "organization_id", "repository_id", "path", "invocation_id"], "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "organization_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "maxLength": 4096}, "invocation_id": {"$ref": "#/$defs/id"}}},
    "data_policy": {"type": "object", "additionalProperties": false, "required": ["retention_days", "redaction", "training", "export"], "properties": {"retention_days": {"type": "integer", "minimum": 1}, "redaction": {"const": "strict"}, "training": {"const": "allow"}, "export": {"const": "allow"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "repository_id", "source_id", "observed_at", "collected_at", "evidence_refs"], "properties": {"kind": {"enum": ["human_confirmed_finding", "rejected_false_positive", "incident_missed_defect", "reviewed_bug_fix_pair", "mutation", "synthetic", "production_feedback"]}, "repository_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "source_run_id": {"$ref": "#/$defs/id"}, "finding_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "collected_at": {"type": "string", "format": "date-time"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_uri"}}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["license_id", "consent", "allowed_uses", "restrictions"], "properties": {"license_id": {"type": "string", "minLength": 1, "maxLength": 512}, "consent": {"enum": ["explicit", "contractual", "authorized_internal", "public_license", "synthetic"]}, "allowed_uses": {"type": "array", "contains": {"const": "training"}, "uniqueItems": true, "items": {"enum": ["candidate_pool", "evaluation", "training", "promotion"]}}, "restrictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["path", "side", "start_line", "end_line", "source_digest"], "properties": {"path": {"type": "string", "minLength": 1}, "side": {"enum": ["old", "new", "file"]}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "source_digest": {"$ref": "#/$defs/sha256"}}},
    "label": {"type": "object", "additionalProperties": false, "required": ["expected_outcome", "anchors", "anchor_refs", "suppression_targets"], "properties": {"expected_outcome": {"enum": ["defect_present", "clean", "false_positive", "missed_defect", "fix_valid", "fix_invalid", "invariant_pass", "invariant_fail"]}, "category": {"$ref": "#/$defs/id"}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "anchors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/anchor"}}, "anchor_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_uri"}}, "suppression_targets": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["cluster_fingerprint"], "properties": {"cluster_fingerprint": {"$ref": "#/$defs/sha256"}}}}}},
    "eligibility": {"type": "object", "additionalProperties": false, "required": ["evaluation", "training", "promotion", "production_distribution"], "properties": {"evaluation": {"const": true}, "training": {"const": true}, "promotion": {"type": "boolean"}, "production_distribution": {"type": "boolean"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "reviewer_ids", "adjudicator_id", "evidence_refs", "statement"], "properties": {"kind": {"enum": ["human_adjudication", "external_governance"]}, "reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "adjudicator_id": {"$ref": "#/$defs/id"}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_uri"}}, "statement": {"const": "independently_adjudicated_not_argus_output"}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["case_id", "case_governance_revision", "case_label_revision", "case_type", "provenance", "license_consent", "classification", "owner", "input_snapshot_ref", "label", "label_policy_revision", "review_state", "dataset_state", "dataset_split", "clone_group_id", "eligibility", "case_created_at", "artifact_refs", "authority"], "properties": {"case_id": {"$ref": "#/$defs/id"}, "case_governance_revision": {"type": "integer", "minimum": 1}, "case_label_revision": {"type": "integer", "minimum": 1}, "case_type": {"enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "fix_validation", "mutation_diagnostic", "workflow_invariant"]}, "provenance": {"$ref": "#/$defs/provenance"}, "license_consent": {"$ref": "#/$defs/license"}, "classification": {"enum": ["public", "internal", "confidential", "restricted"]}, "owner": {"type": "string", "minLength": 1, "maxLength": 256}, "input_snapshot_ref": {"$ref": "#/$defs/artifact_uri"}, "label": {"$ref": "#/$defs/label"}, "label_policy_revision": {"$ref": "#/$defs/id"}, "review_state": {"const": "approved"}, "dataset_state": {"const": "active"}, "dataset_split": {"const": "train"}, "clone_group_id": {"$ref": "#/$defs/id"}, "eligibility": {"$ref": "#/$defs/eligibility"}, "case_created_at": {"type": "string", "format": "date-time"}, "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}}, "authority": {"$ref": "#/$defs/authority"}}}
  }
}
