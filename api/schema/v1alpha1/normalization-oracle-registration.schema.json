{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/normalization-oracle-registration.schema.json",
  "title": "Argus NormalizationOracleRegistration v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle", "oracle_ref", "attestation", "trusted_key", "expected_current_revision", "expected_current_registered_event_id", "registered_at"],
  "properties": {
    "schema_version": {"const": "argus.normalization_oracle_registration.v1alpha1"},
    "oracle": {"$ref": "normalization-oracle.schema.json"},
    "oracle_ref": {"$ref": "#/$defs/oracle_ref"},
    "attestation": {"$ref": "normalization-oracle-attestation.schema.json"},
    "trusted_key": {"$ref": "external-governed-case-import.schema.json#/$defs/trusted_key"},
    "expected_current_revision": {"type": "integer", "minimum": 0},
    "expected_current_registered_event_id": {"type": "string", "maxLength": 256},
    "registered_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"const": "argus.normalization_oracle.v1alpha1+json"}
      }
    }
  }
}
