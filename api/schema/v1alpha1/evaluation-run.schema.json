{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/evaluation-run.schema.json",
  "title": "Argus EvaluationRun v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_run_id", "evaluator_revision", "results", "summary", "created_at", "recorded_at", "recorded_by"],
  "properties": {
    "schema_version": { "const": "argus.evaluation_run.v1alpha1" },
    "evaluation_run_id": { "$ref": "#/$defs/id" },
    "evaluator_revision": { "$ref": "#/$defs/id" },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "summary": { "$ref": "#/$defs/summary" },
    "created_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": { "type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "reason_code": { "$ref": "#/$defs/id" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_type", "label_revision", "label_policy_revision", "expected_outcome", "review_run_id", "review_run_ref", "input_snapshot_ref", "governed_report_ref", "verification_ledger_ref", "calibration_ledger_ref", "suppression_ledger_ref", "report_completeness", "total_finding_count", "evaluated_finding_count", "expected_anchor_count", "matched_anchor_count", "localized_finding_count", "expected_suppression_count", "observed_suppression_count", "suppressed_target_count", "escaped_target_count", "inconclusive_target_count", "apply_checks_executed", "apply_checks_passed", "apply_checks_failed", "apply_authority", "usage_completeness", "usage_receipt_count", "usage_reported_receipts", "usage_partial_receipts", "usage_unavailable_receipts", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "reasoning_reported_receipts", "total_tokens", "usage_authority", "dimensions", "verdict", "reason_code", "defect_presence", "localization", "filter_efficacy", "apply_fidelity", "usage"],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "case_type": { "enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "fix_validation", "mutation_diagnostic", "workflow_invariant"] },
        "label_revision": { "type": "integer", "minimum": 1 },
        "label_policy_revision": { "$ref": "#/$defs/id" },
        "expected_outcome": { "enum": ["defect_present", "clean", "false_positive", "missed_defect", "fix_valid", "fix_invalid", "invariant_pass", "invariant_fail"] },
        "expected_category": { "$ref": "#/$defs/id" },
        "review_run_id": { "$ref": "#/$defs/id" },
        "review_run_ref": { "$ref": "#/$defs/artifact_ref" },
        "input_snapshot_ref": { "$ref": "#/$defs/artifact_ref" },
        "governed_report_ref": { "$ref": "#/$defs/artifact_ref" },
        "verification_ledger_ref": { "$ref": "#/$defs/artifact_ref" },
        "calibration_ledger_ref": { "$ref": "#/$defs/artifact_ref" },
        "suppression_ledger_ref": { "$ref": "#/$defs/artifact_ref" },
        "hypothesis_set_ref": { "$ref": "#/$defs/artifact_ref" },
        "raw_candidate_collection_ref": { "$ref": "#/$defs/artifact_ref" },
        "report_completeness": { "enum": ["complete", "partial"] },
        "total_finding_count": { "type": "integer", "minimum": 0 },
        "evaluated_finding_count": { "type": "integer", "minimum": 0 },
        "expected_anchor_count": { "type": "integer", "minimum": 0 },
        "matched_anchor_count": { "type": "integer", "minimum": 0 },
        "localized_finding_count": { "type": "integer", "minimum": 0 },
        "expected_suppression_count": { "type": "integer", "minimum": 0 },
        "observed_suppression_count": { "type": "integer", "minimum": 0 },
        "suppressed_target_count": { "type": "integer", "minimum": 0 },
        "escaped_target_count": { "type": "integer", "minimum": 0 },
        "inconclusive_target_count": { "type": "integer", "minimum": 0 },
        "apply_trial_id": { "$ref": "#/$defs/id" },
        "apply_edit_script_ref": { "$ref": "#/$defs/artifact_ref" },
        "apply_checks_executed": { "type": "integer", "minimum": 0 },
        "apply_checks_passed": { "type": "integer", "minimum": 0 },
        "apply_checks_failed": { "type": "integer", "minimum": 0 },
        "apply_authority": { "enum": ["unavailable", "local_host_unattested"] },
        "usage_completeness": { "enum": ["provider_reported", "partial", "unavailable"] },
        "usage_receipt_count": { "type": "integer", "minimum": 0 },
        "usage_reported_receipts": { "type": "integer", "minimum": 0 },
        "usage_partial_receipts": { "type": "integer", "minimum": 0 },
        "usage_unavailable_receipts": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_reported_receipts": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "usage_authority": { "enum": ["unavailable", "worker_self_report_diagnostic"] },
        "dimensions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/dimension_result" }
        },
        "verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "reason_code": { "$ref": "#/$defs/id" },
        "defect_presence": { "$ref": "#/$defs/availability" },
        "localization": { "$ref": "#/$defs/availability" },
        "filter_efficacy": { "$ref": "#/$defs/availability" },
        "apply_fidelity": { "$ref": "#/$defs/availability" },
        "usage": { "$ref": "#/$defs/availability" }
      }
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dimension_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "candidate_count", "raw_candidate_count", "normalization_retained_count", "merged_duplicate_count", "rejected_invalid_count", "excluded_budget_count", "context_gap_count", "confirmed_count", "rejected_count", "inconclusive_count", "finding_count", "evaluated_finding_count", "expected_anchor_count", "matched_anchor_count", "localized_finding_count", "review_task_count", "verification_task_count", "tasks_succeeded", "tasks_failed", "tasks_canceled", "model_turns_started", "model_turns_completed", "tool_calls", "cumulative_duration_ms", "usage_completeness", "usage_receipt_count", "usage_reported_receipts", "usage_partial_receipts", "usage_unavailable_receipts", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "reasoning_reported_receipts", "total_tokens", "usage_authority", "verdict", "reason_code", "execution_coverage", "context_coverage", "localization", "normalization", "usage"],
      "properties": {
        "dimension": { "$ref": "#/$defs/versioned_ref" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "raw_candidate_count": { "type": "integer", "minimum": 0 },
        "normalization_retained_count": { "type": "integer", "minimum": 0 },
        "merged_duplicate_count": { "type": "integer", "minimum": 0 },
        "rejected_invalid_count": { "type": "integer", "minimum": 0 },
        "excluded_budget_count": { "type": "integer", "minimum": 0 },
        "context_gap_count": { "type": "integer", "minimum": 0 },
        "confirmed_count": { "type": "integer", "minimum": 0 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "inconclusive_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "evaluated_finding_count": { "type": "integer", "minimum": 0 },
        "expected_anchor_count": { "type": "integer", "minimum": 0 },
        "matched_anchor_count": { "type": "integer", "minimum": 0 },
        "localized_finding_count": { "type": "integer", "minimum": 0 },
        "review_task_count": { "type": "integer", "minimum": 0 },
        "verification_task_count": { "type": "integer", "minimum": 0 },
        "tasks_succeeded": { "type": "integer", "minimum": 0 },
        "tasks_failed": { "type": "integer", "minimum": 0 },
        "tasks_canceled": { "type": "integer", "minimum": 0 },
        "model_turns_started": { "type": "integer", "minimum": 0 },
        "model_turns_completed": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "cumulative_duration_ms": { "type": "integer", "minimum": 0 },
        "usage_completeness": { "enum": ["provider_reported", "partial", "unavailable"] },
        "usage_receipt_count": { "type": "integer", "minimum": 0 },
        "usage_reported_receipts": { "type": "integer", "minimum": 0 },
        "usage_partial_receipts": { "type": "integer", "minimum": 0 },
        "usage_unavailable_receipts": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_reported_receipts": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "usage_authority": { "enum": ["unavailable", "worker_self_report_diagnostic"] },
        "verdict": { "enum": ["pass", "fail", "inconclusive"] },
        "reason_code": { "$ref": "#/$defs/id" },
        "execution_coverage": { "$ref": "#/$defs/availability" },
        "context_coverage": { "$ref": "#/$defs/availability" },
        "localization": { "$ref": "#/$defs/availability" },
        "normalization": { "$ref": "#/$defs/availability" },
        "usage": { "$ref": "#/$defs/availability" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "passed", "failed", "inconclusive", "positive_cases", "positive_passed", "negative_cases", "negative_passed"],
      "properties": {
        "cases": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "positive_cases": { "type": "integer", "minimum": 0 },
        "positive_passed": { "type": "integer", "minimum": 0 },
        "negative_cases": { "type": "integer", "minimum": 0 },
        "negative_passed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
