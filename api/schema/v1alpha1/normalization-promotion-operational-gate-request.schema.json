{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/normalization-promotion-operational-gate-request.schema.json",
  "title": "Argus NormalizationPromotionOperationalGateRequest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variant_id", "gate", "policy_ref", "review_run_ids", "safety_event_count", "evaluated_at"],
  "properties": {
    "schema_version": {"const": "argus.normalization_promotion_operational_gate_request.v1alpha1"},
    "variant_id": {"$ref": "#/$defs/id"},
    "gate": {"enum": ["shadow_traffic", "canary", "promotion_authorization", "rollback_monitor"]},
    "policy_ref": {"$ref": "#/$defs/artifact_ref"},
    "review_run_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "safety_event_count": {"type": "integer", "minimum": 0},
    "authorization": {"$ref": "#/$defs/authorization"},
    "evaluated_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {
      "if": {"properties": {"gate": {"enum": ["shadow_traffic", "canary"]}}},
      "then": {"properties": {"review_run_ids": {"minItems": 1}}, "not": {"required": ["authorization"]}}
    },
    {
      "if": {"properties": {"gate": {"const": "promotion_authorization"}}},
      "then": {"required": ["authorization"], "properties": {"review_run_ids": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"gate": {"const": "rollback_monitor"}}},
      "then": {"properties": {"review_run_ids": {"maxItems": 0}}, "not": {"required": ["authorization"]}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"const": "argus.normalization_promotion_policy.v1alpha1+json"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "authorized_by"],
      "properties": {
        "kind": {"enum": ["human", "policy"]},
        "authorized_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
