{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/local-api-config-transition-command.schema.json",
  "title": "Argus LocalAPIConfigTransitionCommand v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mutation"],
  "properties": {
    "schema_version": {"const": "argus.local_api_config_transition_command.v1alpha1"},
    "mutation": {"$ref": "local-api-mutation.schema.json"},
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percentage"],
      "properties": {
        "percentage": {"type": "integer", "minimum": 1, "maximum": 100},
        "seed": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\p{L}\\p{N}._~-]+$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["rollout"],
        "properties": {
          "rollout": {
            "properties": {"percentage": {"maximum": 99}}
          }
        }
      },
      "then": {
        "properties": {
          "rollout": {"required": ["seed"]}
        }
      }
    }
  ]
}
