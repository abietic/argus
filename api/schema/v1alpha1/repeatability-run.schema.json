{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/repeatability-run.schema.json",
  "title": "Argus RepeatabilityRun v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repeatability_run_id", "repeatability_revision", "baseline_evaluation_run_id", "replay_evaluation_run_ids", "evaluator_revision", "comparisons", "summary", "created_at", "recorded_at", "recorded_by"],
  "properties": {
    "schema_version": { "const": "argus.repeatability_run.v1alpha1" },
    "repeatability_run_id": { "$ref": "#/$defs/id" },
    "repeatability_revision": { "$ref": "#/$defs/id" },
    "baseline_evaluation_run_id": { "$ref": "#/$defs/id" },
    "replay_evaluation_run_ids": { "type": "array", "minItems": 1, "maxItems": 31, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "evaluator_revision": { "$ref": "#/$defs/id" },
    "comparisons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comparison" } },
    "summary": { "$ref": "#/$defs/summary" },
    "created_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$" },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "reason_code": { "$ref": "#/$defs/id" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": { "type": "string", "pattern": "^artifact://local/sha256/[0-9a-f]{64}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_run_id", "review_run_id", "review_run_ref", "governed_report_ref", "report_completeness", "finding_ids", "finding_count", "matched_anchor_count", "localization", "verdict"],
      "properties": {
        "evaluation_run_id": { "$ref": "#/$defs/id" },
        "review_run_id": { "$ref": "#/$defs/id" },
        "review_run_ref": { "$ref": "#/$defs/artifact_ref" },
        "governed_report_ref": { "$ref": "#/$defs/artifact_ref" },
        "report_completeness": { "enum": ["complete", "partial"] },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "finding_count": { "type": "integer", "minimum": 0 },
        "matched_anchor_count": { "type": "integer", "minimum": 0 },
        "localization": { "$ref": "#/$defs/availability" },
        "verdict": { "enum": ["pass", "fail", "inconclusive"] }
      }
    },
    "dimension_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_run_id", "review_run_id", "dimension", "report_completeness", "finding_ids", "finding_count", "candidate_count", "raw_candidate_count", "context_gap_count", "tasks_succeeded", "tasks_failed", "tasks_canceled", "cumulative_duration_ms", "total_tokens", "execution_coverage", "usage", "verdict"],
      "properties": {
        "evaluation_run_id": { "$ref": "#/$defs/id" },
        "review_run_id": { "$ref": "#/$defs/id" },
        "dimension": { "$ref": "#/$defs/versioned_ref" },
        "report_completeness": { "enum": ["complete", "partial"] },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "finding_count": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "raw_candidate_count": { "type": "integer", "minimum": 0 },
        "context_gap_count": { "type": "integer", "minimum": 0 },
        "tasks_succeeded": { "type": "integer", "minimum": 0 },
        "tasks_failed": { "type": "integer", "minimum": 0 },
        "tasks_canceled": { "type": "integer", "minimum": 0 },
        "cumulative_duration_ms": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "execution_coverage": { "$ref": "#/$defs/availability" },
        "usage": { "$ref": "#/$defs/availability" },
        "verdict": { "enum": ["pass", "fail", "inconclusive"] }
      }
    },
    "dimension_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "samples", "sample_count", "pair_count", "finding_set_comparison", "pairwise_jaccard_ppm", "exact_finding_set_pair_count", "exact_finding_set_pair_rate_ppm", "finding_presence_sample_count", "finding_presence_rate_ppm", "verdict_flip_pair_count", "verdict_flip_pair_rate_ppm", "candidate_count_min", "candidate_count_max", "raw_candidate_count_min", "raw_candidate_count_max", "context_gap_count_min", "context_gap_count_max", "tasks_failed_min", "tasks_failed_max", "cumulative_duration_ms_min", "cumulative_duration_ms_max", "total_tokens_min", "total_tokens_max", "execution_comparison", "usage_comparison", "stable"],
      "properties": {
        "dimension": { "$ref": "#/$defs/versioned_ref" },
        "samples": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/dimension_sample" } },
        "sample_count": { "type": "integer", "minimum": 2, "maximum": 32 },
        "pair_count": { "type": "integer", "minimum": 1, "maximum": 496 },
        "finding_set_comparison": { "$ref": "#/$defs/availability" },
        "pairwise_jaccard_ppm": { "$ref": "#/$defs/ppm" },
        "exact_finding_set_pair_count": { "type": "integer", "minimum": 0 },
        "exact_finding_set_pair_rate_ppm": { "$ref": "#/$defs/ppm" },
        "finding_presence_sample_count": { "type": "integer", "minimum": 0 },
        "finding_presence_rate_ppm": { "$ref": "#/$defs/ppm" },
        "verdict_flip_pair_count": { "type": "integer", "minimum": 0 },
        "verdict_flip_pair_rate_ppm": { "$ref": "#/$defs/ppm" },
        "candidate_count_min": { "type": "integer", "minimum": 0 },
        "candidate_count_max": { "type": "integer", "minimum": 0 },
        "raw_candidate_count_min": { "type": "integer", "minimum": 0 },
        "raw_candidate_count_max": { "type": "integer", "minimum": 0 },
        "context_gap_count_min": { "type": "integer", "minimum": 0 },
        "context_gap_count_max": { "type": "integer", "minimum": 0 },
        "tasks_failed_min": { "type": "integer", "minimum": 0 },
        "tasks_failed_max": { "type": "integer", "minimum": 0 },
        "cumulative_duration_ms_min": { "type": "integer", "minimum": 0 },
        "cumulative_duration_ms_max": { "type": "integer", "minimum": 0 },
        "total_tokens_min": { "type": "integer", "minimum": 0 },
        "total_tokens_max": { "type": "integer", "minimum": 0 },
        "execution_comparison": { "$ref": "#/$defs/availability" },
        "usage_comparison": { "$ref": "#/$defs/availability" },
        "stable": { "type": "boolean" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_type", "label_revision", "label_policy_revision", "expected_outcome", "expected_anchor_count", "samples", "dimensions", "sample_count", "pair_count", "finding_set_comparison", "pairwise_jaccard_ppm", "exact_finding_set_pair_count", "exact_finding_set_pair_rate_ppm", "finding_presence_sample_count", "finding_presence_rate_ppm", "expected_anchor_hit", "expected_anchor_hit_sample_count", "expected_anchor_hit_rate_ppm", "finding_count_min", "finding_count_max", "verdict_flip_pair_count", "verdict_flip_pair_rate_ppm", "stable"],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "case_type": { "enum": ["positive_localized", "negative_clean", "false_positive_regression", "missed_defect_regression", "fix_validation", "mutation_diagnostic", "workflow_invariant"] },
        "label_revision": { "type": "integer", "minimum": 1 },
        "label_policy_revision": { "$ref": "#/$defs/id" },
        "expected_outcome": { "enum": ["defect_present", "clean", "false_positive", "missed_defect", "fix_valid", "fix_invalid", "invariant_pass", "invariant_fail"] },
        "expected_category": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expected_anchor_count": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/sample" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension_comparison" } },
        "sample_count": { "type": "integer", "minimum": 2, "maximum": 32 },
        "pair_count": { "type": "integer", "minimum": 1, "maximum": 496 },
        "finding_set_comparison": { "$ref": "#/$defs/availability" },
        "pairwise_jaccard_ppm": { "$ref": "#/$defs/ppm" },
        "exact_finding_set_pair_count": { "type": "integer", "minimum": 0 },
        "exact_finding_set_pair_rate_ppm": { "$ref": "#/$defs/ppm" },
        "finding_presence_sample_count": { "type": "integer", "minimum": 0 },
        "finding_presence_rate_ppm": { "$ref": "#/$defs/ppm" },
        "expected_anchor_hit": { "$ref": "#/$defs/availability" },
        "expected_anchor_hit_sample_count": { "type": "integer", "minimum": 0 },
        "expected_anchor_hit_rate_ppm": { "$ref": "#/$defs/ppm" },
        "finding_count_min": { "type": "integer", "minimum": 0 },
        "finding_count_max": { "type": "integer", "minimum": 0 },
        "verdict_flip_pair_count": { "type": "integer", "minimum": 0 },
        "verdict_flip_pair_rate_ppm": { "$ref": "#/$defs/ppm" },
        "stable": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "samples_per_case", "pairs_per_case", "stable_cases", "unstable_cases", "indeterminate_cases", "finding_set_stability", "pairwise_jaccard_ppm", "exact_finding_set_pair_count", "exact_finding_set_pair_rate_ppm", "verdict_flip_pair_count", "verdict_flip_pair_rate_ppm"],
      "properties": {
        "cases": { "type": "integer", "minimum": 1 },
        "samples_per_case": { "type": "integer", "minimum": 2, "maximum": 32 },
        "pairs_per_case": { "type": "integer", "minimum": 1, "maximum": 496 },
        "stable_cases": { "type": "integer", "minimum": 0 },
        "unstable_cases": { "type": "integer", "minimum": 0 },
        "indeterminate_cases": { "type": "integer", "minimum": 0 },
        "finding_set_stability": { "$ref": "#/$defs/availability" },
        "pairwise_jaccard_ppm": { "$ref": "#/$defs/ppm" },
        "exact_finding_set_pair_count": { "type": "integer", "minimum": 0 },
        "exact_finding_set_pair_rate_ppm": { "$ref": "#/$defs/ppm" },
        "verdict_flip_pair_count": { "type": "integer", "minimum": 0 },
        "verdict_flip_pair_rate_ppm": { "$ref": "#/$defs/ppm" }
      }
    },
    "ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
  }
}
