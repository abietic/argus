{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/local-api-normalization-promotion-canary-command.schema.json",
  "title": "Argus LocalAPINormalizationPromotionCanaryCommand v1alpha1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "variant_id", "policy_ref", "rollout", "mutation"],
  "properties": {
    "schema_version": {"const": "argus.local_api_normalization_promotion_canary_command.v1alpha1"},
    "variant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_ref": {"$ref": "normalization-promotion-operational-gate-request.schema.json#/$defs/artifact_ref"},
    "rollout": {
      "type": "object", "additionalProperties": false, "required": ["percentage", "seed"],
      "properties": {
        "percentage": {"type": "integer", "minimum": 1, "maximum": 99},
        "seed": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\p{L}\\p{N}._~-]+$"}
      }
    },
    "mutation": {"$ref": "local-api-mutation.schema.json"}
  }
}
