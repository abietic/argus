{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/promotion-gate-result.schema.json",
  "title": "Argus PromotionGateResult v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variant_id", "gate", "outcome", "evidence", "summary"],
  "properties": {
    "schema_version": {"const": "argus.promotion_gate_result.v1alpha1"},
    "variant_id": {"$ref": "#/$defs/id"},
    "gate": {"enum": ["schema_contract_validation", "targeted_regression", "fixed_holdout", "shadow_traffic", "canary", "promotion_authorization", "rollback_monitor"]},
    "outcome": {"enum": ["pass", "fail", "inconclusive"]},
    "evidence": {"$ref": "#/$defs/evidence"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]*$"},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["kind", "authorized_by"], "properties": {"kind": {"enum": ["human", "policy"]}, "authorized_by": {"type": "string", "minLength": 1, "maxLength": 256}, "policy_revision": {"$ref": "#/$defs/id"}}},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["refs", "basis", "checks_passed", "holdout_case_ids", "safety_event_count", "rollback_verified"],
      "properties": {
        "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact://[^/]+/.+"}},
        "basis": {"enum": ["deterministic", "human_calibrated", "judge_only"]},
        "checks_passed": {"type": "boolean"},
        "evaluation_run_id": {"$ref": "#/$defs/id"},
        "normalization_quality_run_id": {"$ref": "#/$defs/id"},
        "holdout_case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "safety_event_count": {"type": "integer", "minimum": 0},
        "rollback_verified": {"type": "boolean"},
        "authorization": {"$ref": "#/$defs/authorization"}
      }
    }
  }
}
