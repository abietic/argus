{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/normalization-oracle-revocation.schema.json",
  "title": "Argus NormalizationOracleRevocation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_id", "expected_revision", "expected_registered_event_id", "reason", "revoked_at"],
  "properties": {
    "schema_version": {"const": "argus.normalization_oracle_revocation.v1alpha1"},
    "oracle_id": {"$ref": "#/$defs/id"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "expected_registered_event_id": {"$ref": "#/$defs/id"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "revoked_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"}
  }
}
