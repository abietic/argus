{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/artifact-integrity-change.schema.json",
  "title": "Argus ArtifactIntegrityChange v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ref", "reason", "mutation"],
  "properties": {
    "schema_version": {"const": "argus.artifact_integrity_change.v1alpha1"},
    "ref": {"$ref": "#/$defs/artifact_ref"},
    "reason": {"$ref": "#/$defs/text"},
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "actor", "audit", "at"],
      "properties": {
        "idempotency_key": {"$ref": "#/$defs/text"},
        "actor": {"$ref": "#/$defs/text"},
        "audit": {"$ref": "#/$defs/text"},
        "at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00\\r\\n].*[^\\x00\\r\\n ]$|^[^\\x00\\r\\n ]$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes", "contract"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://local/sha256/[a-f0-9]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "contract": {"type": "string", "minLength": 1}
      }
    }
  }
}
