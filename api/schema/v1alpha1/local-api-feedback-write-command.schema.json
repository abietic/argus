{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schema/v1alpha1/local-api-feedback-write-command.schema.json",
  "title": "Argus LocalAPIFeedbackWriteCommand v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "action", "source", "occurred_at", "source_refs", "mutation"],
  "properties": {
    "schema_version": {"const": "argus.local_api_feedback_write_command.v1alpha1"},
    "feedback_id": {"$ref": "#/$defs/id"},
    "action": {"enum": ["accept", "dismiss", "wont_fix", "outdated", "needs_discussion"]},
    "source": {"$ref": "#/$defs/source"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/source_ref"}},
    "prior_feedback_id": {"$ref": "#/$defs/id"},
    "mutation": {"$ref": "#/$defs/mutation"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\\\x00-\\x1F\\x7F]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["user_interface", "api", "code_host", "ci", "incident", "manual", "import", "system"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "authority", "id"],
      "properties": {
        "kind": {"enum": ["artifact", "event", "change", "comment", "ci_run", "incident", "issue", "manual_observation"]},
        "authority": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "audit", "at"],
      "properties": {
        "schema_version": {"const": "argus.local_api_mutation.v1alpha1"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "audit": {"type": "string", "minLength": 1, "maxLength": 4096},
        "at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
